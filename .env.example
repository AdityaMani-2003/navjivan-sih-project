# =============================================================================
# Navjivan × LastPuff SaaS Production Environment Variables
# =============================================================================

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# ─── Database ────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lastpuff?retryWrites=true&w=majority

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
ADMIN_SEED_EMAIL=admin@navjivan.app

# ─── AI ──────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── Vector DB ───────────────────────────────────────────────
# Local ChromaDB via Docker: docker run -p 8000:8000 chromadb/chroma
# If unavailable, falls back automatically to in-memory cosine similarity
VECTOR_DB_PROVIDER=chroma
CHROMA_URL=http://localhost:8000

# ─── Storage ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Notifications ───────────────────────────────────────────
EXPO_ACCESS_TOKEN=your_expo_push_token
# FCM_SERVER_KEY=your_fcm_server_key  # Optional: for Firebase Cloud Messaging
