# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# ─── MongoDB ─────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lastpuff?retryWrites=true&w=majority

# ─── JWT Authentication ─────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# ─── AI Provider (gemini or claude) ──────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# AI_API_KEY=your_anthropic_api_key_here  # Only if AI_PROVIDER=claude

# ─── Cloudinary (image uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Push Notifications ─────────────────────────────────────
# FCM_SERVER_KEY=your_fcm_server_key  # Future: for Firebase Cloud Messaging
