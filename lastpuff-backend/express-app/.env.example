# MongoDB Connection (both MONGODB_URI and MONGO_URI supported)
MONGO_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/lastpuff
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/lastpuff

# JWT Configuration
JWT_SECRET=your-jwt-secret-key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Gemini API Key for Agentic AI Wellness Insights (free tier: gemini-1.5-flash)
GEMINI_API_KEY=your_google_gemini_api_key

# Server Port
PORT=5000
